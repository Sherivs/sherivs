    {
      "policyname": "admins read student documents",
      "cmd": "SELECT",
      "roles": "{authenticated}",
      "expr": "((bucket_id = 'student-documents'::text) AND (is_super_admin() OR (((storage.foldername(name))[2] = (get_my_school_id())::text) AND can_manage_admissions())))"
    },
    {
