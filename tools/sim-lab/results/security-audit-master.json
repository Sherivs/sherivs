  "storage_policies": [
    {
      "policyname": "admins read student documents",
      "cmd": "SELECT",
      "roles": "{authenticated}",
      "expr": "((bucket_id = 'student-documents'::text) AND (is_super_admin() OR (((storage.foldername(name))[2] = (get_my_school_id())::text) AND can_manage_admissions())))"
    },
    {
      "policyname": "anon can upload admission docs",
      "cmd": "INSERT",
      "roles": "{anon,authenticated}",
      "expr": "((bucket_id = 'student-documents'::text) AND ((storage.foldername(name))[1] = 'admissions'::text))"
    },
    {
      "policyname": "msg_attach_delete_own",
      "cmd": "DELETE",
      "roles": "{authenticated}",
      "expr": "((bucket_id = 'message-attachments'::text) AND ((storage.foldername(name))[1] = (auth.uid())::text))"
    },
    {
      "policyname": "msg_attach_read_participants",
      "cmd": "SELECT",
      "roles": "{authenticated}",
      "expr": "((bucket_id = 'message-attachments'::text) AND (EXISTS ( SELECT 1\n   FROM messages m\n  WHERE ((m.attachment_url = objects.name) AND ((m.sender_id = auth.uid()) "
    },
    {
      "policyname": "msg_attach_upload_own",
      "cmd": "INSERT",
      "roles": "{authenticated}",
      "expr": "((bucket_id = 'message-attachments'::text) AND ((storage.foldername(name))[1] = (auth.uid())::text))"
    },
    {
      "policyname": "school-media delete own school",
      "cmd": "DELETE",
      "roles": "{authenticated}",
      "expr": "((bucket_id = 'school-media'::text) AND ((storage.foldername(name))[1] = (get_my_school_id())::text) AND (COALESCE(lower((storage.foldername(name))[2]), ''::tex"
    },
    {
      "policyname": "school-media insert own school",
      "cmd": "INSERT",
      "roles": "{authenticated}",
      "expr": "((bucket_id = 'school-media'::text) AND ((storage.foldername(name))[1] = (get_my_school_id())::text) AND (COALESCE(lower((storage.foldername(name))[2]), ''::tex"
    },
    {
      "policyname": "school-media read own school",
      "cmd": "SELECT",
      "roles": "{authenticated}",
      "expr": "((bucket_id = 'school-media'::text) AND ((storage.foldername(name))[1] = (get_my_school_id())::text))"
    },
    {
      "policyname": "school-media update own school",
      "cmd": "UPDATE",
      "roles": "{authenticated}",
      "expr": "((bucket_id = 'school-media'::text) AND ((storage.foldername(name))[1] = (get_my_school_id())::text) AND (COALESCE(lower((storage.foldername(name))[2]), ''::tex"
