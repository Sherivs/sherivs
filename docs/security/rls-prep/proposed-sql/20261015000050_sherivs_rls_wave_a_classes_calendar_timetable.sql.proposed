-- CHANGE SET E wave A — classes, school_calendar, timetables, timetable_slots
-- Lexicographic step 5 / 10. First RLS policy wave (H1). After 00045.
-- Depends on: B (inactive helpers fail closed).
-- Pattern: DROP tenant_all_* ; CREATE command policies TO authenticated.
-- Permissive policies OR together — do not leave a residual FOR ALL.
-- C1: session identity is auth.uid() / policies call public helpers.
--     No pg_catalog.auth.* three-part names.

DROP POLICY IF EXISTS tenant_all_classes ON public.classes;

CREATE POLICY classes_select_same_school ON public.classes
  FOR SELECT TO authenticated
  USING (school_id = public.get_my_school_id() OR public.is_super_admin());

CREATE POLICY classes_write_admin ON public.classes
  FOR INSERT TO authenticated
  WITH CHECK (
    public.is_super_admin()
    OR (public.is_school_admin() AND school_id = public.get_my_school_id())
  );

CREATE POLICY classes_update_admin ON public.classes
  FOR UPDATE TO authenticated
  USING (
    public.is_super_admin()
    OR (public.is_school_admin() AND school_id = public.get_my_school_id())
  )
  WITH CHECK (
    public.is_super_admin()
    OR (public.is_school_admin() AND school_id = public.get_my_school_id())
  );

CREATE POLICY classes_delete_admin ON public.classes
  FOR DELETE TO authenticated
  USING (
    public.is_super_admin()
    OR (public.is_school_admin() AND school_id = public.get_my_school_id())
  );

