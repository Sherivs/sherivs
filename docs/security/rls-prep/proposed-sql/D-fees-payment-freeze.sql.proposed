-- CHANGE SET D — Replacement fee-payment reference / settlement path
-- Suggested later migration: 20261015000050_sherivs_fees_settlement_freeze.sql
-- App in the same release train:
--   frontend/src/lib/runtime/scholar/paystack.functions.ts
--     initFeePayment: JWT SELECT for visibility, then supabaseAdmin UPDATE
--       of paystack_reference / paystack_access_code only
--     verifyFeePayment: JWT not used for settlement UPDATE; supabaseAdmin
--       UPDATE status/paid_* keyed by id + paystack_reference after Paystack
--       verify; webhook remains source of truth
--   frontend/src/routes/api/public/webhooks/paystack.ts — already service_role
-- Staging only until GATE 6.

-- Invariant: a user JWT cannot set fees.status = 'paid', cannot overwrite
-- paid_amount/paid_at, and cannot plant a paystack_reference on another
-- school's invoice. Bursar/admin may still INSERT unpaid invoices and
-- UPDATE fee_type/amount/due_date/term/academic_year (change set E).

CREATE OR REPLACE FUNCTION public.freeze_fees_settlement_columns()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
BEGIN
  IF NEW.status IS NOT DISTINCT FROM OLD.status
     AND NEW.paid_amount IS NOT DISTINCT FROM OLD.paid_amount
     AND NEW.paid_at IS NOT DISTINCT FROM OLD.paid_at
     AND NEW.paystack_reference IS NOT DISTINCT FROM OLD.paystack_reference
     AND NEW.paystack_access_code IS NOT DISTINCT FROM OLD.paystack_access_code THEN
    RETURN NEW;
  END IF;

  IF pg_catalog.auth.role() = 'service_role' THEN
    RETURN NEW;
  END IF;

  RAISE EXCEPTION 'fee_settlement_frozen'
    USING ERRCODE = '42501',
          MESSAGE = 'fee settlement columns are not writable with a user JWT';
END;
$$;

REVOKE ALL ON FUNCTION public.freeze_fees_settlement_columns() FROM PUBLIC, anon, authenticated;

DROP TRIGGER IF EXISTS fees_settlement_freeze ON public.fees;
CREATE TRIGGER fees_settlement_freeze
  BEFORE UPDATE OF status, paid_amount, paid_at, paystack_reference, paystack_access_code
  ON public.fees
  FOR EACH ROW
  EXECUTE FUNCTION public.freeze_fees_settlement_columns();

REVOKE UPDATE (
  status, paid_amount, paid_at, paystack_reference, paystack_access_code
) ON public.fees FROM PUBLIC, anon, authenticated;
GRANT UPDATE (
  status, paid_amount, paid_at, paystack_reference, paystack_access_code
) ON public.fees TO service_role;
