-- CHANGE SET G — Grants hygiene
-- Lexicographic step 8 / 10.
-- C3: PostgreSQL GRANT is additive. Withdraw obsolete table privileges with
-- REVOKE ALL (or explicit command REVOKEs) BEFORE granting the allowlist.
-- After every table GRANT UPDATE, re-REVOKE identity, HR, and settlement
-- columns. Do not treat RLS as making leftover INSERT/DELETE harmless.

REVOKE ALL ON TABLE public.users FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.students FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.fees FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.attendance FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.attendance_logs FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.classes FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.parent_student_map FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.lesson_plans FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.timetables FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.timetable_slots FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.school_calendar FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.fraud_attempts FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.subscriptions FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.grades FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.organization_memberships FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.staff_payroll FROM PUBLIC, anon, authenticated;
REVOKE ALL ON TABLE public.teacher_biometrics FROM PUBLIC, anon, authenticated;

-- Intended authenticated allowlist (RLS still gates rows).
GRANT SELECT, UPDATE ON TABLE public.users TO authenticated;
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE public.students TO authenticated;
GRANT SELECT, INSERT, UPDATE ON TABLE public.fees TO authenticated;
GRANT SELECT, INSERT, UPDATE ON TABLE public.attendance TO authenticated;
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE public.attendance_logs TO authenticated;
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE public.classes TO authenticated;
GRANT SELECT ON TABLE public.parent_student_map TO authenticated;
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE public.lesson_plans TO authenticated;
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE public.timetables TO authenticated;
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE public.timetable_slots TO authenticated;
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE public.school_calendar TO authenticated;
GRANT SELECT ON TABLE public.fraud_attempts TO authenticated;
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE public.subscriptions TO authenticated;
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE public.grades TO authenticated;
GRANT SELECT ON TABLE public.organization_memberships TO authenticated;
GRANT SELECT, INSERT, UPDATE ON TABLE public.staff_payroll TO authenticated;
GRANT SELECT, INSERT, UPDATE ON TABLE public.teacher_biometrics TO authenticated;

GRANT ALL ON TABLE public.users TO service_role;
GRANT ALL ON TABLE public.parent_student_map TO service_role;
GRANT ALL ON TABLE public.fees TO service_role;
GRANT ALL ON TABLE public.fraud_attempts TO service_role;
GRANT ALL ON TABLE public.organization_memberships TO service_role;
GRANT ALL ON TABLE public.staff_payroll TO service_role;
GRANT ALL ON TABLE public.teacher_biometrics TO service_role;

-- Explicitly re-withdraw users INSERT/DELETE after GRANT SELECT, UPDATE
-- (documentation + belt: GRANT SELECT, UPDATE must not be read as restoring
-- INSERT/DELETE, and this pair is the catalog assertion).
REVOKE INSERT, DELETE ON TABLE public.users FROM PUBLIC, anon, authenticated;
REVOKE INSERT, UPDATE, DELETE ON TABLE public.organization_memberships
  FROM PUBLIC, anon, authenticated;
REVOKE INSERT, UPDATE, DELETE ON TABLE public.parent_student_map
  FROM PUBLIC, anon, authenticated;
REVOKE INSERT, UPDATE, DELETE ON TABLE public.fraud_attempts
  FROM PUBLIC, anon, authenticated;
REVOKE DELETE ON TABLE public.fees FROM PUBLIC, anon, authenticated;
REVOKE DELETE ON TABLE public.attendance FROM PUBLIC, anon, authenticated;
REVOKE DELETE ON TABLE public.staff_payroll FROM PUBLIC, anon, authenticated;
REVOKE DELETE ON TABLE public.teacher_biometrics FROM PUBLIC, anon, authenticated;
REVOKE TRUNCATE, TRIGGER, REFERENCES ON TABLE public.users,
  public.students, public.fees, public.attendance, public.attendance_logs,
  public.classes, public.parent_student_map, public.lesson_plans,
  public.timetables, public.timetable_slots, public.school_calendar,
  public.fraud_attempts, public.subscriptions, public.grades,
  public.organization_memberships, public.staff_payroll,
  public.teacher_biometrics
  FROM anon, authenticated;

-- Column restrictions AFTER the final table GRANT UPDATE.
REVOKE UPDATE (role, school_id) ON public.users FROM PUBLIC, anon, authenticated;
GRANT UPDATE (role, school_id) ON public.users TO service_role;

REVOKE SELECT, UPDATE (
  salary, nin, bank_name, account_number, account_name, face_biometric
) ON public.users FROM PUBLIC, anon, authenticated;

REVOKE UPDATE (
  status, paid_amount, paid_at, paystack_reference, paystack_access_code
) ON public.fees FROM PUBLIC, anon, authenticated;
GRANT UPDATE (
  status, paid_amount, paid_at, paystack_reference, paystack_access_code
) ON public.fees TO service_role;

-- STATICALLY DERIVED expected catalogs (NOT VERIFIED until staging):
-- authenticated users: SELECT, UPDATE table; NO INSERT, NO DELETE
--   UPDATE(role), UPDATE(school_id): none
--   users.is_active UPDATE: yes (self-change trigger-denied)
--   SELECT/UPDATE salary,nin,bank_*,face_biometric: none
-- authenticated fees: SELECT, INSERT, UPDATE; NO DELETE
--   UPDATE settlement columns: none
-- authenticated organization_memberships: SELECT only
-- anon: none of the tables above
-- service_role: table ALL on users, fees, memberships, payroll, biometrics
