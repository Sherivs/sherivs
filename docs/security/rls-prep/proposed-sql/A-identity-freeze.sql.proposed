-- CHANGE SET A — Trusted identity-column enforcement
-- Apply later as a dedicated forward migration (suggested name after review):
--   20261015000010_sherivs_users_identity_freeze.sql
-- Inverse: database/supabase/rollbacks/ matching prefix.
-- Staging only until GATE 6. Not loaded by db-apply*.mjs.

-- Invariant: authenticated JWTs cannot change public.users.role or
-- public.users.school_id, even when "User updates self" RLS accepts the row.
-- Authorization is computed from auth.role() (JWT) and OLD.*, never NEW.role
-- or NEW.school_id or a client-supplied administrator flag.
--
-- Do NOT use a SET-able GUC latch (sherivs.allow_identity_write). Any session
-- can SET a custom GUC. Legitimate writers already use service_role:
--   switchActiveOrganization, inviteTeacher, createStaffAccount,
--   provisionOrganization, demo-provision (gated), Paystack webhook (fees).
-- School-admin HR role edits MUST move to a TanStack server function that
-- uses supabaseAdmin AFTER requireSchoolAdminScope (change set C).

CREATE OR REPLACE FUNCTION public.freeze_users_identity_columns()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
BEGIN
  IF NEW.school_id IS NOT DISTINCT FROM OLD.school_id
     AND NEW.role IS NOT DISTINCT FROM OLD.role THEN
    RETURN NEW;
  END IF;

  -- auth.role() is the JWT role claim. User-JWT SECURITY DEFINER RPCs remain
  -- 'authenticated' and are denied. service_role (BYPASSRLS admin client)
  -- is the only trusted identity-repoint path.
  IF pg_catalog.auth.role() = 'service_role' THEN
    RETURN NEW;
  END IF;

  RAISE EXCEPTION 'identity_column_frozen'
    USING ERRCODE = '42501',
          MESSAGE = 'users.role and users.school_id are not writable with a user JWT';
END;
$$;

REVOKE ALL ON FUNCTION public.freeze_users_identity_columns() FROM PUBLIC;
REVOKE ALL ON FUNCTION public.freeze_users_identity_columns() FROM anon, authenticated;
-- Trigger functions are invoked by the table owner, not EXECUTE-granted roles.

DROP TRIGGER IF EXISTS users_identity_freeze ON public.users;
CREATE TRIGGER users_identity_freeze
  BEFORE UPDATE OF school_id, role ON public.users
  FOR EACH ROW
  EXECUTE FUNCTION public.freeze_users_identity_columns();

-- Column grants: table-level UPDATE currently implies every column.
REVOKE UPDATE (role, school_id) ON public.users FROM PUBLIC, anon, authenticated;
GRANT UPDATE (role, school_id) ON public.users TO service_role;

-- Memberships must not become a writable privilege store. get_my_* will
-- read users (change set B). Still freeze membership identity columns so a
-- school-admin JWT cannot INSERT a self-grant or rewrite another user's role
-- on organization_memberships without going through users + the sync trigger.
CREATE OR REPLACE FUNCTION public.freeze_membership_identity_columns()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
BEGIN
  IF TG_OP = 'INSERT' THEN
    IF pg_catalog.auth.role() = 'service_role' THEN
      RETURN NEW;
    END IF;
    RAISE EXCEPTION 'membership_identity_frozen'
      USING ERRCODE = '42501',
            MESSAGE = 'organization_memberships identity writes require service_role';
  END IF;

  IF NEW.user_id IS NOT DISTINCT FROM OLD.user_id
     AND NEW.school_id IS NOT DISTINCT FROM OLD.school_id
     AND NEW.role IS NOT DISTINCT FROM OLD.role THEN
    RETURN NEW;
  END IF;

  IF pg_catalog.auth.role() = 'service_role' THEN
    RETURN NEW;
  END IF;

  RAISE EXCEPTION 'membership_identity_frozen'
    USING ERRCODE = '42501',
          MESSAGE = 'organization_memberships identity writes require service_role';
END;
$$;

REVOKE ALL ON FUNCTION public.freeze_membership_identity_columns() FROM PUBLIC;
REVOKE ALL ON FUNCTION public.freeze_membership_identity_columns() FROM anon, authenticated;

DROP TRIGGER IF EXISTS memberships_identity_freeze ON public.organization_memberships;
CREATE TRIGGER memberships_identity_freeze
  BEFORE INSERT OR UPDATE OF user_id, school_id, role ON public.organization_memberships
  FOR EACH ROW
  EXECUTE FUNCTION public.freeze_membership_identity_columns();

-- The existing AFTER trigger sync_organization_membership_on_user_write()
-- runs in the same command as the users UPDATE. When that UPDATE is
-- service_role, this BEFORE trigger on memberships also sees service_role
-- and allows the upsert. Tighten its search_path in the same change set:
CREATE OR REPLACE FUNCTION public.sync_organization_membership_on_user_write()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
BEGIN
  IF TG_OP = 'INSERT' OR NEW.school_id IS DISTINCT FROM OLD.school_id
     OR NEW.role IS DISTINCT FROM OLD.role
     OR NEW.is_active IS DISTINCT FROM OLD.is_active THEN
    IF TG_OP = 'UPDATE' AND NEW.school_id IS DISTINCT FROM OLD.school_id THEN
      UPDATE public.organization_memberships
      SET is_primary = false, updated_at = now()
      WHERE user_id = NEW.id AND is_primary = true
        AND school_id <> NEW.school_id;
    END IF;
    INSERT INTO public.organization_memberships
      (user_id, school_id, role, is_primary, is_active)
    VALUES
      (NEW.id, NEW.school_id, NEW.role, true, COALESCE(NEW.is_active, true))
    ON CONFLICT (user_id, school_id) DO UPDATE
      SET role       = EXCLUDED.role,
          is_active  = EXCLUDED.is_active,
          is_primary = true;
  END IF;
  RETURN NEW;
END;
$$;
