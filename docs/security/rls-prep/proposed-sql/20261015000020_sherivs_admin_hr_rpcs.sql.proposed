-- CHANGE SET C — HR read/write SQL RPCs (salary/profile only)
-- Lexicographic step 2 / 9.
-- Role changes are NOT performed here. See docs/security/rls-prep/HR-RPC-CONTRACT.md
-- for the TanStack hr.functions.ts service_role contract (not implemented
-- in this mission).
-- Depends on: B (is_school_admin requires is_active).
-- App must land in the same release as A (role freeze) — not this mission.

CREATE OR REPLACE FUNCTION public.admin_hr_staff_list()
RETURNS TABLE (
  id uuid,
  full_name text,
  email text,
  phone text,
  role text,
  subject_specialty text,
  employment_type text,
  salary numeric,
  date_enrolled date,
  is_active boolean,
  avatar_url text
)
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
DECLARE
  actor_school uuid;
BEGIN
  IF auth.uid() IS NULL THEN
    RAISE EXCEPTION 'not_authenticated' USING ERRCODE = '28000';
  END IF;
  IF NOT (public.is_school_admin() OR public.is_super_admin()) THEN
    RAISE EXCEPTION 'not_authorized' USING ERRCODE = '42501';
  END IF;
  actor_school := public.get_my_school_id();
  IF actor_school IS NULL AND NOT public.is_super_admin() THEN
    RAISE EXCEPTION 'not_authorized' USING ERRCODE = '42501';
  END IF;

  RETURN QUERY
  SELECT u.id, u.full_name, u.email, u.phone, u.role,
         u.subject_specialty, u.employment_type, u.salary,
         u.date_enrolled, u.is_active, u.avatar_url
  FROM public.users u
  WHERE (public.is_super_admin() OR u.school_id = actor_school)
    AND u.role IN ('teacher','admin','principal','bursar','driver','librarian','nurse');
END;
$$;

-- Salary and employment profile only. No p_role. No school_id. No is_active.
CREATE OR REPLACE FUNCTION public.admin_hr_staff_write(
  p_user_id uuid,
  p_full_name text DEFAULT NULL,
  p_email text DEFAULT NULL,
  p_phone text DEFAULT NULL,
  p_subject_specialty text DEFAULT NULL,
  p_employment_type text DEFAULT NULL,
  p_salary numeric DEFAULT NULL
)
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
DECLARE
  actor_school uuid;
  target_school uuid;
  target_role text;
BEGIN
  IF auth.uid() IS NULL THEN
    RAISE EXCEPTION 'not_authenticated' USING ERRCODE = '28000';
  END IF;
  IF NOT (public.is_school_admin() OR public.is_super_admin()) THEN
    RAISE EXCEPTION 'not_authorized' USING ERRCODE = '42501';
  END IF;
  actor_school := public.get_my_school_id();

  SELECT u.school_id, u.role INTO target_school, target_role
  FROM public.users u
  WHERE u.id = p_user_id;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'not_found' USING ERRCODE = 'P0002';
  END IF;
  IF target_role NOT IN ('teacher','admin','principal','bursar','driver','librarian','nurse') THEN
    RAISE EXCEPTION 'not_staff_target' USING ERRCODE = '42501';
  END IF;
  IF NOT public.is_super_admin() THEN
    IF actor_school IS NULL OR target_school IS DISTINCT FROM actor_school THEN
      RAISE EXCEPTION 'not_authorized' USING ERRCODE = '42501';
    END IF;
  END IF;

  UPDATE public.users u
  SET full_name = COALESCE(p_full_name, u.full_name),
      email = COALESCE(p_email, u.email),
      phone = COALESCE(p_phone, u.phone),
      subject_specialty = COALESCE(p_subject_specialty, u.subject_specialty),
      employment_type = COALESCE(p_employment_type, u.employment_type),
      salary = COALESCE(p_salary, u.salary)
  WHERE u.id = p_user_id
    AND u.role IN ('teacher','admin','principal','bursar','driver','librarian','nurse')
    AND (public.is_super_admin() OR u.school_id = actor_school);
END;
$$;

REVOKE ALL ON FUNCTION public.admin_hr_staff_list() FROM PUBLIC, anon;
REVOKE ALL ON FUNCTION public.admin_hr_staff_write(uuid, text, text, text, text, text, numeric) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.admin_hr_staff_list() TO authenticated, service_role;
GRANT EXECUTE ON FUNCTION public.admin_hr_staff_write(uuid, text, text, text, text, text, numeric) TO authenticated, service_role;
