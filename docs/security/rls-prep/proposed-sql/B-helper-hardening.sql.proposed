-- CHANGE SET B — Inactive-user and membership-aware authorization helpers
-- Suggested later migration: 20261015000020_sherivs_authz_helpers_active.sql
-- Depends on: A (identity freeze) recommended, not strictly required.
-- Staging only until GATE 6.

-- Documented model in 20261008000050: users.school_id/role is the ACTIVE
-- CONTEXT; organization_memberships is the SET; membership rows do not grant
-- authorization. Live helpers currently prefer memberships, which disagrees
-- with is_school_admin() (still reads users.role) and lets a memberships
-- UPDATE escalate get_my_role() without touching users.
--
-- Restore users as the authorization source, and fail closed when the
-- caller is inactive.

CREATE OR REPLACE FUNCTION public.get_my_school_id()
RETURNS uuid
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
  SELECT u.school_id
  FROM public.users u
  WHERE u.id = pg_catalog.auth.uid()
    AND u.is_active IS TRUE;
$$;

CREATE OR REPLACE FUNCTION public.get_my_role()
RETURNS text
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
  SELECT u.role
  FROM public.users u
  WHERE u.id = pg_catalog.auth.uid()
    AND u.is_active IS TRUE;
$$;

CREATE OR REPLACE FUNCTION public.is_school_admin()
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
  SELECT EXISTS (
    SELECT 1
    FROM public.users u
    WHERE u.id = pg_catalog.auth.uid()
      AND u.is_active IS TRUE
      AND u.role IN ('admin', 'principal')
  );
$$;

-- is_super_admin() already checks super_admins.is_active (20261003000020).
-- Re-assert search_path hygiene without changing semantics.
CREATE OR REPLACE FUNCTION public.is_super_admin()
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
  SELECT EXISTS (
    SELECT 1
    FROM public.super_admins s
    WHERE s.id = pg_catalog.auth.uid()
      AND s.is_active = true
  );
$$;

-- Membership SET reader: active memberships only. Unchanged contract.
CREATE OR REPLACE FUNCTION public.get_my_memberships()
RETURNS TABLE (school_id uuid, role text, is_primary boolean)
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
  SELECT m.school_id, m.role, m.is_primary
  FROM public.organization_memberships m
  JOIN public.users u ON u.id = m.user_id
  WHERE m.user_id = pg_catalog.auth.uid()
    AND m.is_active = true
    AND u.is_active IS TRUE
  ORDER BY m.is_primary DESC, m.created_at ASC;
$$;

REVOKE ALL ON FUNCTION public.get_my_school_id() FROM PUBLIC, anon;
REVOKE ALL ON FUNCTION public.get_my_role() FROM PUBLIC, anon;
REVOKE ALL ON FUNCTION public.is_school_admin() FROM PUBLIC, anon;
REVOKE ALL ON FUNCTION public.is_super_admin() FROM PUBLIC, anon;
REVOKE ALL ON FUNCTION public.get_my_memberships() FROM PUBLIC, anon;

GRANT EXECUTE ON FUNCTION public.get_my_school_id() TO authenticated, service_role;
GRANT EXECUTE ON FUNCTION public.get_my_role() TO authenticated, service_role;
GRANT EXECUTE ON FUNCTION public.is_school_admin() TO authenticated, service_role;
GRANT EXECUTE ON FUNCTION public.is_super_admin() TO authenticated, service_role;
GRANT EXECUTE ON FUNCTION public.get_my_memberships() TO authenticated, service_role;
