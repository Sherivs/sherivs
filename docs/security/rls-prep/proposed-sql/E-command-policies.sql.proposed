-- ---------------------------------------------------------------------------
-- fees  (B4: deny DELETE; D freezes settlement columns)
-- ---------------------------------------------------------------------------
DROP POLICY IF EXISTS tenant_all_fees ON public.fees;

CREATE POLICY fees_select_finance_staff ON public.fees
  FOR SELECT TO authenticated
  USING (
    public.is_super_admin()
    OR (
      school_id = public.get_my_school_id()
      AND public.get_my_role() IN ('admin','principal','bursar','hq')
    )
  );

CREATE POLICY fees_select_self ON public.fees
  FOR SELECT TO authenticated
  USING (
    student_id IN (SELECT s.id FROM public.students s WHERE s.user_id = pg_catalog.auth.uid())
  );

CREATE POLICY fees_select_mapped_parent ON public.fees
  FOR SELECT TO authenticated
  USING (
    student_id IN (
      SELECT m.student_id FROM public.parent_student_map m
      WHERE m.parent_id = pg_catalog.auth.uid()
    )
  );

CREATE POLICY fees_insert_finance ON public.fees
  FOR INSERT TO authenticated
  WITH CHECK (
    public.is_super_admin()
    OR (
      school_id = public.get_my_school_id()
      AND public.get_my_role() IN ('admin','principal','bursar')
      AND status IN ('unpaid','partial')
    )
  );

CREATE POLICY fees_update_finance_non_settlement ON public.fees
  FOR UPDATE TO authenticated
  USING (
    public.is_super_admin()
    OR (
      school_id = public.get_my_school_id()
      AND public.get_my_role() IN ('admin','principal','bursar')
    )
  )
  WITH CHECK (
    public.is_super_admin()
    OR (
      school_id = public.get_my_school_id()
      AND public.get_my_role() IN ('admin','principal','bursar')
    )
  );

-- No DELETE policy. Settlement column writes denied by change set D trigger
-- unless service_role.

-- ---------------------------------------------------------------------------
-- fraud_attempts  (B7: deny authenticated writes)
-- ---------------------------------------------------------------------------
DROP POLICY IF EXISTS tenant_all_fraud_attempts ON public.fraud_attempts;

CREATE POLICY fraud_attempts_select_admin ON public.fraud_attempts
  FOR SELECT TO authenticated
  USING (
    public.is_super_admin()
    OR (public.is_school_admin() AND school_id = public.get_my_school_id())
  );

-- No INSERT/UPDATE/DELETE for authenticated.

-- ---------------------------------------------------------------------------
-- subscriptions
-- ---------------------------------------------------------------------------
DROP POLICY IF EXISTS tenant_all_subscriptions ON public.subscriptions;

CREATE POLICY subscriptions_all_super_admin ON public.subscriptions
  FOR ALL TO authenticated
  USING (public.is_super_admin())
  WITH CHECK (public.is_super_admin());
