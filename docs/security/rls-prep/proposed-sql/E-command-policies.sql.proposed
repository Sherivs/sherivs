-- ---------------------------------------------------------------------------
-- students  (B2: teachers retain same-school SELECT)
-- ---------------------------------------------------------------------------
DROP POLICY IF EXISTS tenant_all_students ON public.students;

CREATE POLICY students_select_staff_same_school ON public.students
  FOR SELECT TO authenticated
  USING (
    public.is_super_admin()
    OR (
      school_id = public.get_my_school_id()
      AND public.get_my_role() IN ('admin','principal','teacher','bursar','hq','driver')
    )
  );

CREATE POLICY students_select_self ON public.students
  FOR SELECT TO authenticated
  USING (user_id = pg_catalog.auth.uid());

CREATE POLICY students_select_mapped_parent ON public.students
  FOR SELECT TO authenticated
  USING (
    id IN (
      SELECT m.student_id
      FROM public.parent_student_map m
      WHERE m.parent_id = pg_catalog.auth.uid()
    )
  );

CREATE POLICY students_write_admin ON public.students
  FOR INSERT TO authenticated
  WITH CHECK (
    public.is_super_admin()
    OR (public.is_school_admin() AND school_id = public.get_my_school_id())
  );

CREATE POLICY students_update_admin ON public.students
  FOR UPDATE TO authenticated
  USING (
    public.is_super_admin()
    OR (public.is_school_admin() AND school_id = public.get_my_school_id())
  )
  WITH CHECK (
    public.is_super_admin()
    OR (public.is_school_admin() AND school_id = public.get_my_school_id())
  );

CREATE POLICY students_delete_admin ON public.students
  FOR DELETE TO authenticated
  USING (
    public.is_super_admin()
    OR (public.is_school_admin() AND school_id = public.get_my_school_id())
  );

-- ---------------------------------------------------------------------------
-- parent_student_map  (B1: deny authenticated writes)
-- SELECT kept for parent portals, teacher class-parent broadcast,
-- admin fanout, and driver milestone notify.
-- ---------------------------------------------------------------------------
DROP POLICY IF EXISTS tenant_all_parent_student_map ON public.parent_student_map;

CREATE POLICY parent_student_map_select_own ON public.parent_student_map
  FOR SELECT TO authenticated
  USING (parent_id = pg_catalog.auth.uid() OR public.is_super_admin());

CREATE POLICY parent_student_map_select_school_staff ON public.parent_student_map
  FOR SELECT TO authenticated
  USING (
    school_id = public.get_my_school_id()
    AND public.get_my_role() IN ('admin','principal','teacher','driver','bursar','hq')
  );

-- No INSERT/UPDATE/DELETE policies for authenticated. service_role remains
-- the only writer (demo-provision today; future admin RPC is a product decision).

-- ---------------------------------------------------------------------------
-- lesson_plans  (B3: students/parents SELECT approved only — schema supports
-- status IN ('draft','submitted','approved','needs_revision'))
-- ---------------------------------------------------------------------------
DROP POLICY IF EXISTS tenant_all_lesson_plans ON public.lesson_plans;

CREATE POLICY lesson_plans_select_teacher_own ON public.lesson_plans
  FOR SELECT TO authenticated
  USING (
    public.is_super_admin()
    OR teacher_id = pg_catalog.auth.uid()
    OR (public.is_school_admin() AND school_id = public.get_my_school_id())
  );

CREATE POLICY lesson_plans_select_approved_class ON public.lesson_plans
  FOR SELECT TO authenticated
  USING (
    status = 'approved'
    AND school_id = public.get_my_school_id()
    AND (
      class_id IN (SELECT s.class_id FROM public.students s WHERE s.user_id = pg_catalog.auth.uid())
      OR class_id IN (
        SELECT s.class_id
        FROM public.students s
        JOIN public.parent_student_map m ON m.student_id = s.id
        WHERE m.parent_id = pg_catalog.auth.uid()
      )
    )
  );

CREATE POLICY lesson_plans_insert_teacher ON public.lesson_plans
  FOR INSERT TO authenticated
  WITH CHECK (
    public.is_super_admin()
    OR (
      school_id = public.get_my_school_id()
      AND teacher_id = pg_catalog.auth.uid()
      AND public.get_my_role() IN ('teacher','admin','principal')
    )
  );

CREATE POLICY lesson_plans_update_owner_or_admin ON public.lesson_plans
  FOR UPDATE TO authenticated
  USING (
    public.is_super_admin()
    OR teacher_id = pg_catalog.auth.uid()
    OR (public.is_school_admin() AND school_id = public.get_my_school_id())
  )
  WITH CHECK (
    public.is_super_admin()
    OR (
      school_id = public.get_my_school_id()
      AND (
        teacher_id = pg_catalog.auth.uid()
        OR public.is_school_admin()
      )
    )
  );

CREATE POLICY lesson_plans_delete_owner_or_admin ON public.lesson_plans
  FOR DELETE TO authenticated
  USING (
    public.is_super_admin()
    OR teacher_id = pg_catalog.auth.uid()
    OR (public.is_school_admin() AND school_id = public.get_my_school_id())
  );

-- ---------------------------------------------------------------------------
-- attendance  (B4: deny ordinary DELETE)
-- ---------------------------------------------------------------------------
DROP POLICY IF EXISTS tenant_all_attendance ON public.attendance;

CREATE POLICY attendance_select_staff ON public.attendance
  FOR SELECT TO authenticated
  USING (
    public.is_super_admin()
    OR (
      school_id = public.get_my_school_id()
      AND public.get_my_role() IN ('admin','principal','teacher','hq')
    )
  );

CREATE POLICY attendance_select_self ON public.attendance
  FOR SELECT TO authenticated
  USING (
    student_id IN (SELECT s.id FROM public.students s WHERE s.user_id = pg_catalog.auth.uid())
  );

CREATE POLICY attendance_select_mapped_parent ON public.attendance
  FOR SELECT TO authenticated
  USING (
    student_id IN (
      SELECT m.student_id FROM public.parent_student_map m
      WHERE m.parent_id = pg_catalog.auth.uid()
    )
  );

CREATE POLICY attendance_write_teaching_staff ON public.attendance
  FOR INSERT TO authenticated
  WITH CHECK (
    public.is_super_admin()
    OR (
      school_id = public.get_my_school_id()
      AND public.get_my_role() IN ('admin','principal','teacher')
      AND marked_by = pg_catalog.auth.uid()
    )
  );

CREATE POLICY attendance_update_teaching_staff ON public.attendance
  FOR UPDATE TO authenticated
  USING (
    public.is_super_admin()
    OR (
      school_id = public.get_my_school_id()
      AND public.get_my_role() IN ('admin','principal','teacher')
    )
  )
  WITH CHECK (
    public.is_super_admin()
    OR (
      school_id = public.get_my_school_id()
      AND public.get_my_role() IN ('admin','principal','teacher')
    )
  );

-- No DELETE policy for authenticated.

