# CoreGrid Scholar — production runtime environment manifest (NAMES ONLY).
#
# This file lists every environment variable the deployment expects, with NO
# values. Never put a real value in any file under git (§30). The operator
# copies this shape to /opt/coregrid/scholar.env on the VM (mode 600,
# root-owned) and fills values out-of-band (Cursor Secrets / secret manager).
#
# Cross-checked against: .env.example, frontend/src/lib/env.ts
# (REQUIRED_VARS[production], SERVER_ONLY_VARS), and the lib/ adapters
# (ai-gateway.server.ts, paystack.functions.ts, push.server.ts,
# resend-email adapter, vapi-voice.server.ts, digital-twin.functions.ts).

# --- Runtime shape -----------------------------------------------------------
# Listen port inside the container (srvx binds this; image default 3000).
PORT=3000
NODE_ENV=production

# --- Supabase (reality data layer) -------------------------------------------
# Project URL and publishable (anon) key — required in production per
# frontend/src/lib/env.ts REQUIRED_VARS["production"].
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY. Never prefix with VITE_ (would bundle into the client).
SUPABASE_SERVICE_ROLE_KEY=

# Client-side (build-time in the image via VITE_ build args; also accepted at
# runtime for SSR consistency):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- AI gateway (server-side only) -------------------------------------------
AI_API_KEY=
# Optional override of the gateway base URL (default: provider default in
# frontend/src/lib/ai-gateway.server.ts).
AI_GATEWAY_URL=

# --- Payments (Paystack) -------------------------------------------------------
# Server-side secret key used for webhook signature verification and
# transaction initialize/verify. sk_live_... in production (BLK-4).
PAYSTACK_SECRET_KEY=

# --- Web push (VAPID) ----------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
VITE_VAPID_PUBLIC_KEY=

# --- Email (Resend) ------------------------------------------------------------
# NOTE: used by the Resend email adapter (V1-009). Not yet declared in
# .env.example (known V1-009 gap) — declared here so the VM env file is
# authoritative. RESEND_FROM_ADDRESS is the verified sender identity.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# --- Voice/telephony (Vapi) ----------------------------------------------------
# Credential-gated stub in V1: present key is validated but no live call path
# ships (adapter returns provider_not_live). Declared for parity.
VAPI_API_KEY=

# --- SMS (Twilio gateway) ------------------------------------------------------
TWILIO_API_KEY=
TWILIO_FROM_NUMBER=
TWILIO_GATEWAY_URL=

# --- Demo provisioning ---------------------------------------------------------
# MUST remain false in production. The public demo-provisioning server
# function refuses to run unless this is exactly "true" (Phase 01 §45/§34).
ALLOW_DEMO_PROVISIONING=false

# --- Build-time-only (NOT part of the runtime env file) ------------------------
# The VITE_PUBLIC_* build args are injected at `docker build` time as build
# args and are baked into the static client bundle. They are NOT secrets and
# MUST NOT be placed in /opt/coregrid/scholar.env. See infrastructure/README.md.