# CoreGrid Mobile environment contract.
#
# Names only — never commit real values (Constitution §30).
# Expo inlines EXPO_PUBLIC_* variables into the app bundle at build time;
# every variable below is NON-SECRET by design (publishable/anon key only).
# Service-role keys and any server-only secret must NEVER appear here.

# CoreGrid environment channel (drives API endpoint selection).
# One of: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Supabase project coordinates (same project as the web app).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable (anon) key — public by design, protected by RLS server-side.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Base URL of the deployed CoreGrid web app (TanStack Start). Mobile calls
# the web app's server functions under the /_serverFn/<id> URL contract.
EXPO_PUBLIC_COREGRID_WEB_BASE_URL=https://app.coregrid.example

# TanStack Start server-function ids are build-generated content hashes of
# frontend/src/lib/*.functions.ts. Supply the ids emitted by the deployed
# web build for each contract mobile consumes. Until provided, the affected
# screens degrade to an explicit "endpoint not configured" state (fail closed,
# never a fabricated response).
EXPO_PUBLIC_SERVER_FN_RECORD_FOUNDATION_LOOP=
EXPO_PUBLIC_SERVER_FN_LIST_IDENTITIES=