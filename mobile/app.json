{
  "expo": {
    "name": "Scholar",
    "slug": "coregrid-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "scholar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sherivs.scholar",
      "supportsTablet": true,
      "associatedDomains": [
        "webcredentials:sherivs.com",
        "applinks:app.sherivs.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sherivs.scholar",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.sherivs.com",
              "pathPrefix": "/m/"
            },
            {
              "scheme": "https",
              "host": "app.sherivs.com",
              "pathPrefix": "/home/notifications"
            },
            {
              "scheme": "https",
              "host": "app.sherivs.com",
              "pathPrefix": "/results"
            },
            {
              "scheme": "https",
              "host": "app.sherivs.com",
              "pathPrefix": "/fees"
            },
            {
              "scheme": "https",
              "host": "app.sherivs.com",
              "pathPrefix": "/messages"
            },
            {
              "scheme": "https",
              "host": "app.sherivs.com",
              "pathPrefix": "/cbt"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F3A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e19ca55-cc79-4634-ae8a-bf8b551a6a20"
      }
    },
    "owner": "sherivs"
  }
}
