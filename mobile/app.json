{
  "expo": {
    "name": "Sherivs",
    "slug": "coregrid-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "coregrid",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.coregrid.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "associatedDomains": [
        "webcredentials:sherivs.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.coregrid.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F3A"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F3A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e19ca55-cc79-4634-ae8a-bf8b551a6a20"
      }
    },
    "owner": "sherivs"
  }
}
