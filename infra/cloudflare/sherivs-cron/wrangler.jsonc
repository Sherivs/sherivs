{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sherivs-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "preview_urls": false,
  // Exposes the deployed Worker version id as env.CF_VERSION_METADATA (service.version tag). Free.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "vars": {
    "TARGET_BASE_URL": "https://www.sherivs.com",
    "ROUTE_WALLET_TOPUP_RECONCILE": "true",
    "ROUTE_WORKFLOW_TICK": "false",
    "ROUTE_ORG_NOTIFICATIONS": "false",
    "ROUTE_JARVIS_TICK": "false",
    "ROUTE_INTEGRATIONS_SYNC": "false",
    "ROUTE_ORG_WEEKLY_REPORTS": "false",
    // Datadog EU export (traces + logs over OTLP). Off unless exactly "true"; needs the DD_API_KEY
    // Worker secret. Turning it on in production is an operator decision, not part of a deploy.
    "OBSERVABILITY_DATADOG_ENABLED": "false",
    "DD_SITE": "datadoghq.eu",
    "DEPLOYMENT_ENVIRONMENT": "production",
  },
  "env": {
    "staging": {
      "name": "sherivs-cron-staging",
      "vars": {
        // Replace before staging use; this must point at staging, never production.
        "TARGET_BASE_URL": "https://staging-placeholder.invalid",
        "ROUTE_WALLET_TOPUP_RECONCILE": "false",
        "ROUTE_WORKFLOW_TICK": "true",
        "ROUTE_ORG_NOTIFICATIONS": "false",
        "ROUTE_JARVIS_TICK": "false",
        "ROUTE_INTEGRATIONS_SYNC": "false",
        "ROUTE_ORG_WEEKLY_REPORTS": "false",
        "OBSERVABILITY_DATADOG_ENABLED": "false",
        "DD_SITE": "datadoghq.eu",
        "DEPLOYMENT_ENVIRONMENT": "staging",
      },
    },
  },
}
