# CoreGrid Scholar environment variables
# Copy to .env for local development. Never commit .env.
#
# SECURITY CONTRACT (mission: provider credential orchestration)
# - Names marked [SECRET] are server-side only and must NEVER be exposed via a
#   VITE_/NEXT_PUBLIC_/PUBLIC_ prefix (enforced by tests/unit/env.test.ts and
#   scripts/verification/secret-scan.mjs).
# - Names marked [INFRA] are deployment/CI scope only — never app runtime.
# - Names marked [PUBLIC] are client-safe where the framework prefix requires it.
# - The full machine-readable classification lives in
#   frontend/src/lib/providers/provider-credentials.ts.

# Supabase (project: nwrflbpbhyiqdptmlccm)
# [PUBLIC]  client-visible project URL / publishable key (RLS is the boundary)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# [SECRET]  service-role key is SERVER-ONLY. Never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
# Cloudflare Turnstile site key (public). Empty = captcha widget off.
# Set together with Supabase Auth → Attack Protection → Captcha (Turnstile secret).
VITE_TURNSTILE_SITE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local / preview only: simulate a host kind (internal | app | public_platform | tenant)
# for console host routing. Ignored on real production hostnames.
VITE_SHERIVS_HOST_KIND_OVERRIDE=
# Local / preview only: Internal Console role simulation on localhost. Production
# builds ignore this. Set to 1 with Vite DEV to sign in as each V1 console role.
VITE_CONSOLE_VISUAL_FIXTURE=
# [INFRA]   management API + direct-Postgres verification channels (scripts/)
SUPABASE_ACCESS_TOKEN=
DATABASE_URL=
# Former name COREGRID_DB_CA_CERT is still honoured as a fallback (all SHERIVS_* vars).
SHERIVS_DB_CA_CERT=
SUPABASE_CA_CERT=

# AI gateway (server-side, provider-neutral OpenAI-compatible; §20/§25)
# [SECRET]  AI_API_KEY is the gateway bearer — server-only.
AI_API_KEY=
# [SERVER-CONFIG] OpenAI-compatible gateway base URL (e.g. a DeepSeek endpoint).
AI_GATEWAY_URL=
# Model id used by scripts/verify-ai-gateway-live.drill.mjs (server config).
AI_DRILL_MODEL=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=

# Web push (VAPID)
# [SECRET]  VAPID_PRIVATE_KEY is server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
VITE_VAPID_PUBLIC_KEY=

# Payments (Paystack — server-side verification is authoritative; §36)
# [SECRET]  secret key signs/verifies webhooks; never client-side.
PAYSTACK_SECRET_KEY=
# Server config: override for the test-rails drill (default https://api.paystack.co).
PAYSTACK_BASE_URL=

# Email delivery (Resend) — server-side only; never VITE_-prefixed (RESEND_API_KEY is a bearer secret)
# [SECRET]  RESEND_API_KEY
RESEND_API_KEY=
# [SERVER-CONFIG] verified sender identity for outbound email.
RESEND_FROM_ADDRESS=

# Voice AI (Vapi credential-gated stub) — server-side only
# [SECRET]  VAPI_API_KEY
VAPI_API_KEY=

# WhatsApp Cloud API — server-side only; webhook: /api/public/webhooks/whatsapp
# [SECRET] Meta system-user access token.
WHATSAPP_TOKEN=
# [SERVER-CONFIG] Cloud API phone number ID used for sends.
WHATSAPP_PHONE_NUMBER_ID=
# [SECRET] Meta app secret used to validate X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# [SECRET] Random verify token configured identically in Meta and this environment.
WHATSAPP_VERIFY_TOKEN=

# Telephony (Twilio) — server-side only
# [SERVER-CONFIG] account identifier used with the auth token (Basic SID:TOKEN).
TWILIO_ACCOUNT_SID=
# [SECRET]  auth token: REST auth + inbound webhook signature verification.
TWILIO_AUTH_TOKEN=
# [SERVER-CONFIG] E.164 sender number provisioned in the Twilio console
# (requires a purchased/verified number — human action, not derivable).
TWILIO_FROM_NUMBER=
# [SERVER-CONFIG] PREFERRED REST auth: API key SID (SK…) + secret, Basic SK:secret.
# When both are set they take precedence over TWILIO_AUTH_TOKEN for REST calls
# (SMS, voice, health probe). TWILIO_AUTH_TOKEN is still needed to verify
# inbound webhook signatures. A non-SK value keeps the legacy gateway meaning.
TWILIO_API_KEY=
# [SECRET]  API key secret (server-only).
TWILIO_API_SECRET=
# Legacy voice-gateway override (digital-twin call site).
TWILIO_GATEWAY_URL=

# Africa's Talking Voice support line — V1, disabled until voice_live is enabled.
# Configure AT's inbound callback as AT_VOICE_CALLBACK_URL with
# ?token=<AT_VOICE_WEBHOOK_TOKEN>; follow-up callback URLs include the same token.
# [SERVER-CONFIG] Africa's Talking account username.
AT_USERNAME=sherivs
# [SECRET] Africa's Talking API key; server-only.
AT_API_KEY=
# [SECRET] Random callback authentication token; use a high-entropy value.
AT_VOICE_WEBHOOK_TOKEN=
# [SERVER-CONFIG] Public HTTPS URL of the voice callback endpoint.
AT_VOICE_CALLBACK_URL=
# Provider choices: openai (STT), ai-gateway (LLM), africas_talking (AT <Say> TTS).
VOICE_STT_PROVIDER=openai
# [SECRET] OpenAI-compatible transcription API key; server-only.
VOICE_STT_API_KEY=
VOICE_STT_BASE_URL=https://api.openai.com/v1
VOICE_STT_MODEL=whisper-1
VOICE_LLM_PROVIDER=ai-gateway
VOICE_LLM_MODEL=google/gemini-3-flash-preview
VOICE_TTS_PROVIDER=africas_talking

# Analytics / observability vendors — UN-FROZEN for V1 (DECISIONS.md #204):
# every credential below carries a read-only verification probe in
# observability/provider-health.server.ts. Analytics ingestion itself still
# requires §19/§20/§21 compliance before any surface is built.
# [SECRET]  PostHog management API (server-side; cannot ingest client events).
POSTHOG_PERSONAL_API_KEY=
# [PUBLIC]  project ingest key (client-safe by design; grabbed via the
# management API 2026-10-06 and provisioned to Vercel). No analytics surface
# ships until §19/§20/§21 compliance is implemented and tested.
POSTHOG_PROJECT_API_KEY=
# [SERVER-CONFIG] region-qualified PostHog API host. US default shown;
# EU projects must use https://eu.posthog.com.
POSTHOG_API_URL=https://us.posthog.com
# [INFRA]   release/source-map upload only (a runtime DSN would be separate).
# The supplied token may be narrow (e.g. org:ci) — see the onboarding guide.
SENTRY_AUTH_TOKEN=
# [INFRA]   infrastructure observability plane.
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_USER_KEY=
# [SERVER-CONFIG] region-qualified New Relic GraphQL host. EU default shown
# (evidence-backed 2026-10-06); US accounts use https://api.newrelic.com.
NEW_RELIC_API_URL=https://api.eu.newrelic.com

# Deployment / infrastructure planes — CI scope only, never app runtime.
# [INFRA]
CLOUDFLARE_API_TOKEN=
VERCEL_API_TOKEN=
EXPO_TOKEN=

# Optional distributed rate-limit plane (Upstash-compatible REST).
# UN-FROZEN by DECISIONS.md #204; absent credentials keep the in-process
# limiter active (Part 31) and the provider-health battery stays ok.
# [SERVER-CONFIG] https-only REST data-plane endpoint.
REDIS_REST_URL=
# [SECRET]  bearer token for the REST data plane (server-only).
REDIS_REST_TOKEN=

# E2E tests
PLAYWRIGHT_BASE_URL=http://localhost:8080
# Observability (optional — the app runs unchanged when these are empty)
# [PUBLIC]  Sentry DSN (project sherivs-web) for the browser and server, and
#           PostHog EU project key/host. Analytics only start after consent.
VITE_SENTRY_DSN=
SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# [INFRA]   source-map upload at build time only (optional; skipped when empty)
SENTRY_AUTH_TOKEN=

# SHERIVS-028: bearer secret for /api/public/cron/wallet-topup-reconcile (schedule every 10-15 min)
CRON_SECRET=

# WebAuthn / passkeys (server-side only — never VITE_ / NEXT_PUBLIC_ / PUBLIC_)
# [SERVER-CONFIG] Human-readable relying party name shown by authenticators.
WEBAUTHN_RP_NAME=Sherivs
# [SERVER-CONFIG] RP ID must be a suffix of the browser hostname.
# Local development:
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080
# Production (Vercel / app.sherivs.com). Login is not the marketing apex.
# WEBAUTHN_RP_ID=sherivs.com
# WEBAUTHN_ORIGIN=https://app.sherivs.com
# WEBAUTHN_ALLOWED_ORIGINS=https://app.sherivs.com,https://console.sherivs.com,https://sherivs.com,https://www.sherivs.com
# Extra exact origins, comma-separated. https subdomains of the RP ID are also
# accepted. Custom school domains that are not sherivs.com hosts cannot use
# RP ID sherivs.com.
WEBAUTHN_ALLOWED_ORIGINS=
# [SERVER-CONFIG] Optional challenge lifetime in ms (30000–600000). Default 300000.
WEBAUTHN_CHALLENGE_TTL_MS=
# Native associated domains (public JSON at /.well-known/…). Empty = no apps advertised.
# [SERVER-CONFIG] 10-character Apple Team ID for apple-app-site-association.
WEBAUTHN_APPLE_TEAM_ID=
# [SERVER-CONFIG] iOS bundle id (default com.coregrid.app).
WEBAUTHN_IOS_BUNDLE_ID=com.coregrid.app
# [SERVER-CONFIG] Android package (default com.coregrid.app).
WEBAUTHN_ANDROID_PACKAGE=com.coregrid.app
# [SERVER-CONFIG] Colon-separated SHA-256 cert fingerprints, comma-delimited.
WEBAUTHN_ANDROID_SHA256_CERTS=
