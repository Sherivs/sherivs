# CoreGrid Scholar environment variables
# Copy to .env for local development. Never commit .env.

# Demo provisioning (development fixture isolation, Phase 01 §45/§34).
# When false (default) the public "try demo" provisioning server function
# refuses to run in every environment. NEVER enable on production.
ALLOW_DEMO_PROVISIONING=false

# Supabase (project: nwrflbpbhyiqdptmlccm)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service-role key is SERVER-ONLY. Never prefix it with VITE_ (that would
# bundle it into the client).
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# AI gateway (server-side)
AI_API_KEY=
AI_GATEWAY_URL=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=

# Web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
VITE_VAPID_PUBLIC_KEY=

# Payments (Paystack webhook verification)
PAYSTACK_SECRET_KEY=

# SMS / messaging
TWILIO_API_KEY=
TWILIO_FROM_NUMBER=
TWILIO_GATEWAY_URL=

# E2E tests
PLAYWRIGHT_BASE_URL=http://localhost:8080

# Email delivery (Resend) — server-side only; never VITE_-prefixed (RESEND_API_KEY is a bearer secret)
RESEND_API_KEY=
# Verified sender identity for outbound email — server-side only; never VITE_-prefixed
RESEND_FROM_ADDRESS=
# Voice AI (Vapi stub credential gate) — server-side only; never VITE_-prefixed
VAPI_API_KEY=
